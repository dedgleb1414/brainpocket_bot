# Скопируй в .env и заполни значениями
# .env НЕ коммитить в Git (он в .gitignore)

# Токен от @BotFather
BOT_TOKEN=123456789:ABCdef...

# URL твоего деплоя на Vercel
WEBHOOK_URL=https://brainpocket.vercel.app/api/webhook

# Строка подключения к PostgreSQL (Supabase / Neon)
# Формат: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
